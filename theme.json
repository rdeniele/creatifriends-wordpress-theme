{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "768px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "base",            "color": "#0B0B12", "name": "Base" },
				{ "slug": "base-2",          "color": "#15151F", "name": "Base Elevated" },
				{ "slug": "contrast",        "color": "#F6F5F0", "name": "Contrast" },
				{ "slug": "contrast-2",      "color": "#C9C7BE", "name": "Contrast Soft" },
				{ "slug": "muted",           "color": "#6B6A78", "name": "Muted" },
				{ "slug": "accent",          "color": "#FF5B49", "name": "Accent" },
				{ "slug": "accent-2",        "color": "#FFD166", "name": "Accent Warm" },
				{ "slug": "accent-3",        "color": "#7A5CFF", "name": "Accent Cool" },
				{ "slug": "surface",         "color": "#FFFFFF", "name": "Surface" }
			],
			"gradients": [
				{
					"slug": "brand",
					"name": "Brand",
					"gradient": "linear-gradient(135deg, #FF5B49 0%, #7A5CFF 100%)"
				},
				{
					"slug": "warm",
					"name": "Warm",
					"gradient": "linear-gradient(135deg, #FFD166 0%, #FF5B49 100%)"
				},
				{
					"slug": "cool",
					"name": "Cool",
					"gradient": "linear-gradient(135deg, #7A5CFF 0%, #0B0B12 100%)"
				},
				{
					"slug": "glow",
					"name": "Glow",
					"gradient": "radial-gradient(circle at 30% 20%, rgba(255,91,73,0.35) 0%, rgba(122,92,255,0.15) 35%, rgba(11,11,18,0) 70%)"
				}
			],
			"duotone": [
				{
					"slug": "brand-duotone",
					"name": "Brand Duotone",
					"colors": ["#0B0B12", "#FF5B49"]
				},
				{
					"slug": "cool-duotone",
					"name": "Cool Duotone",
					"colors": ["#0B0B12", "#7A5CFF"]
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/Inter-Variable.woff2"]
						}
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Space Grotesk', Inter, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/SpaceGrotesk-Variable.woff2"]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra Small",
					"size": "0.75rem",
					"fluid": { "min": "0.75rem", "max": "0.8125rem" }
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": { "min": "0.875rem", "max": "0.9375rem" }
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": { "min": "1rem", "max": "1.0625rem" }
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": { "min": "1.125rem", "max": "1.375rem" }
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "1.75rem",
					"fluid": { "min": "1.5rem", "max": "2rem" }
				},
				{
					"slug": "xx-large",
					"name": "Heading",
					"size": "2.5rem",
					"fluid": { "min": "2rem", "max": "3rem" }
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "3.75rem",
					"fluid": { "min": "2.75rem", "max": "4.5rem" }
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "5.5rem",
					"fluid": { "min": "3.5rem", "max": "7rem" }
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "2X-Small", "size": "clamp(0.5rem, 0.75vw, 0.75rem)" },
				{ "slug": "30", "name": "X-Small",  "size": "clamp(0.75rem, 1.25vw, 1rem)" },
				{ "slug": "40", "name": "Small",    "size": "clamp(1rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "Medium",   "size": "clamp(1.5rem, 3vw, 2rem)" },
				{ "slug": "60", "name": "Large",    "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "70", "name": "X-Large",  "size": "clamp(3rem, 6vw, 5rem)" },
				{ "slug": "80", "name": "2X-Large", "size": "clamp(4rem, 8vw, 7rem)" },
				{ "slug": "90", "name": "3X-Large", "size": "clamp(5rem, 10vw, 9rem)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "sm",    "name": "Small",    "shadow": "0 1px 2px 0 rgba(11,11,18,0.06)" },
				{ "slug": "md",    "name": "Medium",   "shadow": "0 8px 24px -8px rgba(11,11,18,0.18)" },
				{ "slug": "lg",    "name": "Large",    "shadow": "0 24px 48px -16px rgba(11,11,18,0.28)" },
				{ "slug": "glow",  "name": "Glow",     "shadow": "0 0 0 1px rgba(122,92,255,0.25), 0 12px 40px -6px rgba(255,91,73,0.35)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			},
			"core/navigation": {
				"typography": {
					"fontWeight": true,
					"textTransform": true,
					"letterSpacing": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--base)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6",
			"letterSpacing": "-0.005em"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--40)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent-3)" },
					"typography": { "textDecoration": "underline" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.08",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "letterSpacing": "-0.035em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)",    "letterSpacing": "-0.03em" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em",
					"fontWeight": "500"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--base)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.01em"
				},
				"border": { "radius": "9999px" },
				"spacing": {
					"padding": {
						"top": "0.85rem", "right": "1.5rem",
						"bottom": "0.85rem", "left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--base)" },
						":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--huge)",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.05"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" }
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"letterSpacing": "-0.015em"
				},
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"width": "0 0 0 4px",
					"style": "solid"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"width": "0 0 0 3px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"background": "var(--wp--preset--color--base-2)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": { "radius": "12px" },
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide Page (no sidebar, full width)",
			"postTypes": ["page"]
		},
		{
			"name": "page-landing",
			"title": "Landing Page (no header/footer chrome)",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{ "name": "header",       "title": "Header",       "area": "header" },
		{ "name": "header-dark",  "title": "Header (Dark)","area": "header" },
		{ "name": "footer",       "title": "Footer",       "area": "footer" },
		{ "name": "sidebar",      "title": "Sidebar",      "area": "uncategorized" },
		{ "name": "post-meta",    "title": "Post Meta",    "area": "uncategorized" },
		{ "name": "comments",     "title": "Comments",     "area": "uncategorized" }
	]
}
