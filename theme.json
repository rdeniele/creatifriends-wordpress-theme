{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "base",         "color": "#0A0A0A", "name": "Base" },
				{ "slug": "surface",      "color": "#111111", "name": "Surface" },
				{ "slug": "elevated",     "color": "#1A1A1A", "name": "Elevated" },
				{ "slug": "contrast",     "color": "#FFFFFF", "name": "Contrast" },
				{ "slug": "muted",        "color": "#B3B3B3", "name": "Muted" },
				{ "slug": "border",       "color": "#2A2A2A", "name": "Border" },
				{ "slug": "accent",       "color": "#D4AF37", "name": "Gold" },
				{ "slug": "accent-hover", "color": "#E6C766", "name": "Gold Hover" }
			],
			"gradients": [
				{
					"slug": "gold",
					"name": "Gold",
					"gradient": "linear-gradient(135deg, #D4AF37 0%, #E6C766 100%)"
				},
				{
					"slug": "gold-soft",
					"name": "Gold Soft",
					"gradient": "linear-gradient(180deg, rgba(212,175,55,0.12) 0%, rgba(212,175,55,0) 100%)"
				},
				{
					"slug": "cinematic",
					"name": "Cinematic",
					"gradient": "linear-gradient(180deg, #0A0A0A 0%, #111111 50%, #0A0A0A 100%)"
				},
				{
					"slug": "vignette",
					"name": "Vignette",
					"gradient": "radial-gradient(120% 80% at 50% 0%, rgba(212,175,55,0.08) 0%, rgba(10,10,10,0) 60%)"
				},
				{
					"slug": "fade-to-base",
					"name": "Fade to Base",
					"gradient": "linear-gradient(180deg, rgba(10,10,10,0) 0%, #0A0A0A 100%)"
				}
			],
			"duotone": [
				{
					"slug": "noir",
					"name": "Noir",
					"colors": ["#0A0A0A", "#FFFFFF"]
				},
				{
					"slug": "gold-noir",
					"name": "Gold Noir",
					"colors": ["#0A0A0A", "#D4AF37"]
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Space Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Eyebrow",
					"size": "0.75rem",
					"fluid": { "min": "0.6875rem", "max": "0.8125rem" }
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": { "min": "0.8125rem", "max": "0.9375rem" }
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem",
					"fluid": { "min": "1rem", "max": "1.0625rem" }
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "1.25rem",
					"fluid": { "min": "1.125rem", "max": "1.375rem" }
				},
				{
					"slug": "x-large",
					"name": "H4",
					"size": "1.75rem",
					"fluid": { "min": "1.5rem", "max": "2rem" }
				},
				{
					"slug": "xx-large",
					"name": "H3",
					"size": "2.5rem",
					"fluid": { "min": "2rem", "max": "3rem" }
				},
				{
					"slug": "huge",
					"name": "H2",
					"size": "3.75rem",
					"fluid": { "min": "2.75rem", "max": "4.5rem" }
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "6rem",
					"fluid": { "min": "3.75rem", "max": "7.5rem" }
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "2X-Small", "size": "clamp(0.5rem, 0.75vw, 0.75rem)" },
				{ "slug": "30", "name": "X-Small",  "size": "clamp(0.75rem, 1.25vw, 1rem)" },
				{ "slug": "40", "name": "Small",    "size": "clamp(1rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "Medium",   "size": "clamp(1.5rem, 3vw, 2.25rem)" },
				{ "slug": "60", "name": "Large",    "size": "clamp(2.25rem, 4.5vw, 3.5rem)" },
				{ "slug": "70", "name": "X-Large",  "size": "clamp(3.5rem, 7vw, 6rem)" },
				{ "slug": "80", "name": "2X-Large", "size": "clamp(5rem, 10vw, 8.5rem)" },
				{ "slug": "90", "name": "3X-Large", "size": "clamp(7rem, 14vw, 12rem)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "sm",     "name": "Soft",     "shadow": "0 1px 0 0 rgba(255,255,255,0.04) inset, 0 1px 2px 0 rgba(0,0,0,0.5)" },
				{ "slug": "md",     "name": "Lift",     "shadow": "0 1px 0 0 rgba(255,255,255,0.04) inset, 0 16px 40px -16px rgba(0,0,0,0.7)" },
				{ "slug": "lg",     "name": "Cinematic","shadow": "0 1px 0 0 rgba(255,255,255,0.05) inset, 0 40px 80px -24px rgba(0,0,0,0.85)" },
				{ "slug": "gold",   "name": "Gold Glow","shadow": "0 0 0 1px rgba(212,175,55,0.35), 0 16px 48px -12px rgba(212,175,55,0.25)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			},
			"core/navigation": {
				"typography": {
					"fontWeight": true,
					"textTransform": true,
					"letterSpacing": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"letterSpacing": "0"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--40)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent-hover)" },
					"typography": { "textDecoration": "none" }
				},
				":focus": {
					"color": { "text": "var(--wp--preset--color--accent-hover)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.05",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "fontWeight": "700", "letterSpacing": "-0.045em", "lineHeight": "0.98" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)",    "fontWeight": "600", "letterSpacing": "-0.035em", "lineHeight": "1.02" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "600", "letterSpacing": "-0.025em" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "500", "letterSpacing": "-0.015em" } },
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				}
			},
			"h6": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500",
					"textTransform": "uppercase",
					"letterSpacing": "0.24em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				},
				"border": {
					"radius": "12px",
					"width": "1px",
					"color": "var(--wp--preset--color--accent)",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"top": "1.05rem", "right": "2rem",
						"bottom": "1.05rem", "left": "2rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": { "color": "var(--wp--preset--color--accent-hover)" }
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": { "color": "var(--wp--preset--color--accent-hover)" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.04em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.025em"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
					}
				}
			},
			"core/site-tagline": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.24em"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "600",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.02"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" },
				"spacing": { "margin": { "top": "var(--wp--preset--spacing--50)", "bottom": "var(--wp--preset--spacing--50)" } }
			},
			"core/pullquote": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "500",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.2"
				},
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"width": "1px 0",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/quote": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "500"
				},
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"width": "0 0 0 1px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"background": "var(--wp--preset--color--elevated)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"radius": "2px",
					"width": "1px",
					"color": "var(--wp--preset--color--border)",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/navigation": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500",
					"textTransform": "uppercase",
					"letterSpacing": "0.18em"
				}
			},
			"core/search": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"border": { "color": "var(--wp--preset--color--border)", "radius": "0px" }
			},
			"core/post-terms": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.2em",
					"fontWeight": "500"
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.04em"
				}
			},
			"core/image": {
				"border": { "radius": "16px" }
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Wide Page (no sidebar, full width)",
			"postTypes": ["page"]
		},
		{
			"name": "page-landing",
			"title": "Landing Page (no header/footer chrome)",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{ "name": "header",       "title": "Header",        "area": "header" },
		{ "name": "header-dark",  "title": "Header (Solid)","area": "header" },
		{ "name": "footer",       "title": "Footer",        "area": "footer" },
		{ "name": "sidebar",      "title": "Sidebar",       "area": "uncategorized" },
		{ "name": "post-meta",    "title": "Post Meta",     "area": "uncategorized" },
		{ "name": "comments",     "title": "Comments",      "area": "uncategorized" }
	]
}
